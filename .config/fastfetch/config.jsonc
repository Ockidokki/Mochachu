{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "/home/ocki/.config/fastfetch/Aruko-nobg.png",
        "type": "kitty",
        "width": 24,
        "height": 10,
        "padding": {
            "top": 2,
            "right": 2
            
        }
    },
    "display": {
        "separator": " ",
        "color": {
        "title": "#C1948B", },
    },
    "modules": [
	"break",
	"break",
	{
            "type": "title",
            "keyWidth": 10,
        },
        "break",
        {
            "type": "os",
            "key": " ",
            "keyColor": "#C1948B",
        },
        {
            "type": "kernel",
            "key": " ",
            "keyColor": "#C1948B",
        },
        {
            "type": "packages",
            "format": "{flatpak-all} Flatpaks & {pacman} PACs",
            "key": " ",
            "keyColor": "#C1948B",
        },
        {
            "type": "shell",
            "key": " ",
            "keyColor": "#C1948B",
        },
        {
            "type": "terminal",
            "key": " ",
            "keyColor": "#C1948B",
        },
        {
            "type": "wm",
            "key": " ",
            "keyColor": "#C1948B",
        },
        {
            "type": "uptime",
            "key": " ",
            "keyColor": "#C1948B",
        },
        {
          
        },
        "break",
        "break",
    ]
}
